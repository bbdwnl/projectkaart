# --- Supabase (Frankfurt) ---
# Verplicht. Project Settings -> API: de URL en de publishable (of anon) key. Die key mag in
# de browser; de toegang wordt afgedwongen met RLS (zie supabase/migrations).
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Alleen op de server: de service-role (of secret) key. Daarmee leest server/api/punten de open punten
# voor de pagina van een leverancier (een gedeelde link met code). Nooit met NUXT_PUBLIC_ ervoor.
NUXT_SUPABASE_SERVICE_KEY=

# Alleen e-mailadressen op dit domein kunnen een inloglink krijgen (staat ook in de database: toegestane_domeinen()).
# NUXT_PUBLIC_EMAIL_DOMEIN=bbdw.nl

# Alleen op de server: het geheim waarmee de sessies achter de koppelingen met Copilot versleuteld worden (Copilot via
# /api/mcp en OAuth, zie README). Minstens 32 tekens, bijvoorbeeld: openssl rand -hex 32. Leeg = Copilot werkt nog niet.
# Verander je het, dan werken de bestaande koppelingen niet meer; iedereen logt dan in Copilot opnieuw in.
NUXT_COPILOT_GEHEIM=
# Het vaste adres van de app, zonder / aan het eind: de uitgever van de OAuth-tokens voor Copilot. In Vercel:
# https://projectkaart.bbdw.nl. Lokaal leeg laten: dan het adres waarop het verzoek binnenkomt (http://localhost:3000).
NUXT_PUBLIC_APP_URL=
# Alleen als Copilot Studio een ander terugadres gebruikt dan *.consent.azure-apim.net (dan staat het in de log van
# Vercel als "registreren geweigerd"): die host erbij, met komma's. Bijvoorbeeld: .voorbeeld.microsoft.com
NUXT_COPILOT_TERUGADRESSEN=

# Alleen op Vercel: een lang willekeurig geheim voor de nachtelijke back-up (Vercel Cron stuurt het mee naar
# /api/backup). Zonder deze variabele maakt de route geen back-up. Bijvoorbeeld: openssl rand -hex 32
CRON_SECRET=
