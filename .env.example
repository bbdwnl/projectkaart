# --- Supabase (Frankfurt) ---
# Verplicht. Project Settings -> API: de URL en de publishable (of anon) key. Die key mag in
# de browser; de toegang wordt afgedwongen met RLS (zie supabase/migrations).
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Alleen op de server: de service-role (of secret) key. Daarmee leest server/api/punten de open punten
# voor de pagina van een leverancier (een gedeelde link met code). Nooit met NUXT_PUBLIC_ ervoor.
NUXT_SUPABASE_SERVICE_KEY=

# Alleen e-mailadressen op dit domein kunnen een inloglink krijgen (staat ook in de database: toegestane_domeinen()).
# NUXT_PUBLIC_EMAIL_DOMEIN=bbdw.nl

# Alleen op Vercel: een lang willekeurig geheim voor de nachtelijke back-up (Vercel Cron stuurt het mee naar
# /api/backup). Zonder deze variabele maakt de route geen back-up. Bijvoorbeeld: openssl rand -hex 32
CRON_SECRET=
