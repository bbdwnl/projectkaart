# --- Proefversie ---
# Tijdelijk wachtwoord voor de proefversie. Leeg = iedereen met de link kan erin.
# Wordt op de server gecontroleerd; een nieuw wachtwoord maakt alle bestaande toegang ongeldig.
NUXT_PROEF_WACHTWOORD=

# --- Supabase (Frankfurt) ---
# Leeg laten = demo-modus: de app draait in het geheugen met voorbeeldgegevens.
# Project Settings -> API: de URL en de publishable (of anon) key. Die key mag in
# de browser; de toegang wordt afgedwongen met RLS (zie supabase/migrations).
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Alleen accounts met dit e-maildomein worden toegelaten (staat ook in RLS).
# NUXT_PUBLIC_EMAIL_DOMEIN=bbdw.nl
